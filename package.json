{
  "name": "sori",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first foundation for Sori, a voice-to-useful-output workspace prototype.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/adapters/http/server.ts",
    "build": "tsc -p tsconfig.json",
    "test:types": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --exclude dist/**",
    "check": "npm run build && npm run test && npm run desktop:check",
    "tray:mock": "tsx src/tray/mock-shell.ts",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:build": "npm --prefix apps/desktop run build",
    "build:bundle": "npm --prefix apps/desktop run build:bundle",
    "desktop:installer": "npm --prefix apps/desktop run build:installer",
    "desktop:check": "npm --prefix apps/desktop run check",
    "e2e:desktop-backend": "tsx scripts/e2e-desktop-backend.ts",
    "e2e:backend-ipc": "cargo test -p sorid --test backend_ipc_e2e -- --nocapture",
    "e2e:reliability": "tsx scripts/e2e-reliability.ts",
    "e2e:desktop-native": "tsx scripts/e2e-desktop-native.ts",
    "e2e:windows-hotkey-injection": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows-hotkey-injection-acceptance.ps1",
    "e2e:windows-text-insertion": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows-text-insertion-acceptance.ps1",
    "e2e:windows-wave3-acceptance": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows-wave3-final-acceptance.ps1",
    "e2e:desktop-ocu": "tsx scripts/e2e-desktop-ocu.ts",
    "e2e:product": "tsx scripts/e2e-product-gate.ts",
    "e2e:native-bridge": "tsx scripts/e2e-native-bridge.ts",
    "e2e:full-product": "tsx scripts/e2e-full-product.ts",
    "test:windows-packaging": "node scripts/test-windows-packaging.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "fastify": "^5.6.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
